{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development (Clang, Debug)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "V8MALLOC_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (GCC)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG",
        "V8MALLOC_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "format",
      "configurePreset": "dev",
      "targets": ["format"]
    },
    {
      "name": "format-check",
      "configurePreset": "dev",
      "targets": ["format-check"]
    },
    {
      "name": "tidy",
      "configurePreset": "dev",
      "targets": ["tidy"]
    },
    {
      "name": "cppcheck",
      "configurePreset": "dev",
      "targets": ["cppcheck"]
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
