{
  "name": "C11 Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools",
        "EditorConfig.EditorConfig"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
